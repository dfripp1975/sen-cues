# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it contains secrets.

# --- Site ---------------------------------------------------------------
# The public address of your app (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown in the Privacy Policy and Terms.
NEXT_PUBLIC_COMPANY_NAME=EventFill

# --- Supabase (required for accounts and data) --------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard (/admin) -------------------------------------------
# Comma-separated list of email addresses allowed into the admin area.
ADMIN_EMAILS=you@example.com

# --- Stripe (optional until you want to take payments) -------------------
# Use TEST keys (sk_test_...) while developing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# --- AI Content Studio (optional) ---------------------------------------
# Leave ANTHROPIC_API_KEY empty to disable AI (users get labelled example templates instead).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. For much lower cost per generation, set claude-haiku-5-5.
AI_MODEL=
# Hard monthly safety cap across ALL customers, in US dollars (estimated). 0 = no cap.
AI_MONTHLY_BUDGET_USD=20

# --- Scheduled data-retention job ---------------------------------------
# Any long random string. Vercel Cron sends it automatically when set in Vercel.
CRON_SECRET=
