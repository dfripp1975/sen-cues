# ---------- Client (safe to expose: these are public by design) ----------
# Supabase project URL and *anon* key (Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to "true" only after enabling the Google provider in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false
# Web push public key (generate with: npx web-push generate-vapid-keys).
VITE_VAPID_PUBLIC_KEY=

# ---------- Server-only secrets (set with `supabase secrets set ...`, NEVER prefix with VITE_) ----------
# AI_PROVIDER=gemini            # or "openai"
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional, for OpenAI-compatible endpoints
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...   # £5.99 / month
# STRIPE_PRICE_YEARLY=price_...    # £39.99 / year
# APP_URL=https://your-faithly-domain.example
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@your-domain.example
# REMINDER_CRON_SECRET=a-long-random-string

# ---------- Legal pages ----------
# Shown on the Privacy Policy and Terms pages. Have both pages reviewed by a qualified adviser before launch.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
