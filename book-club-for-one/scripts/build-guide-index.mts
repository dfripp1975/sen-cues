// Writes src/data/guides.ts: for each book with built-in chapter guides, which
// chapters the guide covers (some guides cover chapters 1 to 5, others five key
// chapters spread through the book). It is a small file the shelf and search can
// load without pulling in the full guide content (src/data/bookContent.ts).
// Re-run after adding or extending chapter guides:
//   npx tsx scripts/build-guide-index.mts
import { writeFileSync } from 'node:fs';
import { bookChapters, bookCharacters } from '../src/data/bookContent';

const coverage: Record<string, number[]> = {};
for (const [slug, chapters] of Object.entries(bookChapters)) {
  if (chapters.length && bookCharacters[slug]?.length) coverage[slug] = chapters.map(c => c.number).sort((a, b) => a - b);
}
const sorted = Object.fromEntries(Object.entries(coverage).sort(([a], [b]) => a.localeCompare(b)));
writeFileSync(new URL('../src/data/guides.ts', import.meta.url),
  '// Generated by scripts/build-guide-index.mts from src/data/bookContent.ts.\n' +
  '// slug -> chapters covered by the built-in chapter guide. Helpers live in guideHelpers.ts.\n' +
  'export const guideCoverage: Record<string, number[]> = ' + JSON.stringify(sorted) + ';\n');
console.log(Object.keys(sorted).length, 'books with built-in guides');
