// Looks up a real Open Library cover for every book by title and author, and
// writes src/data/covers.ts (slug -> Open Library cover id). The ISBNs in the
// book data are unreliable (many fail their checksum, many are shared between
// different books), so covers are matched on title and author instead.
//   npx tsx scripts/resolve-covers.mts
// Behind an HTTPS proxy, Node's fetch ignores HTTPS_PROXY unless told:
//   NODE_USE_ENV_PROXY=1 npx tsx scripts/resolve-covers.mts
import { writeFileSync } from 'node:fs';
import { allBooks } from '../src/data/books';

const UA = 'BookClubForOne-cover-resolver/1.0';
const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/&/g, 'and').replace(/^(the|a|an) /, '').replace(/[^a-z0-9]+/g, ' ').trim();
const surname = (a: string) => norm(a).split(' ').filter(Boolean).pop() || '';

async function get(url: string, tries = 3): Promise<any> {
  for (let i = 0; i < tries; i++) {
    try {
      const r = await fetch(url, { headers: { 'User-Agent': UA } });
      if (r.ok) return r.json();
    } catch {}
    await new Promise(r => setTimeout(r, 800 * (i + 1)));
  }
  return null;
}

async function resolve(title: string, author: string) {
  const fields = 'title,author_name,cover_i,edition_count';
  const q = `https://openlibrary.org/search.json?title=${encodeURIComponent(title)}&author=${encodeURIComponent(author)}&limit=10&fields=${fields}`;
  const data = await get(q);
  const docs: any[] = data?.docs || [];
  const want = norm(title), sn = surname(author);
  const ok = docs.filter(d => d.cover_i && (norm(d.title) === want || norm(d.title).startsWith(want + ' ') || want.startsWith(norm(d.title) + ' '))
    && (d.author_name || []).some((a: string) => surname(a) === sn || norm(a).includes(sn)));
  ok.sort((a, b) => (b.edition_count || 0) - (a.edition_count || 0));   // the most-edited work is the canonical one
  return ok[0]?.cover_i ?? null;
}

async function exists(id: number) {
  try {
    const r = await fetch(`https://covers.openlibrary.org/b/id/${id}-M.jpg?default=false`, { method: 'HEAD', redirect: 'manual', headers: { 'User-Agent': UA } });
    return r.status === 302 || r.status === 200;
  } catch { return false; }
}

const unique = [...new Map(allBooks.map(b => [b.slug, b])).values()];
const out: Record<string, number> = {};
const misses: string[] = [];
let done = 0;
const queue = [...unique];
await Promise.all(Array.from({ length: 4 }, async () => {
  while (queue.length) {
    const b = queue.shift()!;
    const id = await resolve(b.title, b.author);
    if (id && await exists(id)) out[b.slug] = id; else misses.push(`${b.title} (${b.author})`);
    if (++done % 50 === 0) console.log(`${done}/${unique.length}`);
    await new Promise(r => setTimeout(r, 150));
  }
}));

const sorted = Object.fromEntries(Object.entries(out).sort(([a], [b]) => a.localeCompare(b)));
writeFileSync(new URL('../src/data/covers.ts', import.meta.url), `// Generated by scripts/resolve-covers.mts. Open Library cover ids, matched on title and author.\n// Books missing here show the typeset cover. Re-run the script after adding books.\nexport const coverIds: Record<string, number> = ${JSON.stringify(sorted, null, 2)};\n`);
console.log(`found ${Object.keys(out).length} of ${unique.length}`);
console.log('no cover found:', misses.length, misses.slice(0, 40).join(' | '));
