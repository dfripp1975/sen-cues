VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# The live address, used in the sitemap and robots.txt (no trailing slash)
VITE_SITE_URL=https://thebookclubforone.com
# Google AdSense publisher ID, e.g. ca-pub-1234567890123456. Adds the account tag,
# ads.txt and ad slots. Ads never show on reading pages.
VITE_ADSENSE_CLIENT=
# Consent for ads: 'google' uses Google's consent message (set it up in AdSense,
# Privacy & messaging); 'site' uses this site's own cookie banner instead.
VITE_ADSENSE_CMP=google

# AI features (chapter guides, chat). They cost money per request. Off unless set to true.
VITE_AI_ENABLED=false
