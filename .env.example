# Copy this file to .env and fill in real values. Never commit .env itself.

# From Supabase project settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only — set this with `supabase secrets set`, never in this file
# once it's a real Supabase project. Listed here just so the Edge Function's
# expected variable name is documented in one place.
# ANTHROPIC_API_KEY=sk-ant-...
